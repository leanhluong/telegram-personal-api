# Copy file này thành .env và điền giá trị thực.

# ── BẮT BUỘC ────────────────────────────────────────────────────────────────
# api_id / api_hash của MỘT ỨNG DỤNG đăng ký tại https://my.telegram.org
# → API development tools.
#
# ĐÂY KHÔNG PHẢI BOT TOKEN. Bot token đi đường Bot API, không dùng được cho MTProto.
# Thiếu cặp này thì service DỪNG NGAY lúc khởi động (cố ý — để lỗi không nổ muộn
# ở lần quét QR đầu tiên, lúc người dùng chỉ nhìn thấy vòng xoay).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Upstream ────────────────────────────────────────────────────────────────
# Base URL của hệ thống nhận inbound và cấp phiên để khôi phục.
UPSTREAM_BASE_URL=http://localhost:5000

# Đường webhook nhận inbound phía upstream. Service POST tin đến vào đây.
UPSTREAM_WEBHOOK_PATH=/api/v1/webhook/telegram-personal

# Endpoint upstream trả danh sách phiên cần khôi phục (kèm sessionString đã lưu).
UPSTREAM_SESSIONS_PATH=/api/v1/channels/telegram-personal/internal/sessions

# Khoá gửi kèm header X-System-Key khi gọi upstream.
# Phải khớp khoá upstream đang chờ, lệch là upstream trả 401 và tin đến rơi im lặng.
SYSTEM_KEY=

# ── Phụ thuộc HAI CHIỀU ─────────────────────────────────────────────────────
# Địa chỉ upstream gọi NGƯỢC lại service để lấy ảnh đại diện và tệp đính kèm.
#
# Telegram không có URL công khai cho bất cứ tệp nào — chúng chỉ tải được qua một
# phiên đã đăng nhập. Vì vậy service tự phục vụ chúng ở /avatars/* và /media/*.
# Địa chỉ này chỉ nên sống trong mạng nội bộ: ai gọi được là đọc được tệp riêng tư
# của khách (service KHÔNG xác thực request đến).
PUBLIC_BASE_URL=http://telegram-personal-api:3200

# ── Tuỳ chọn ────────────────────────────────────────────────────────────────
PORT=3200

# Hạn của CẢ PHIÊN đăng nhập QR (người dùng mở hộp thoại rồi bỏ đi),
# không phải hạn của một mã QR — Telegram tự làm mới mã ~30 giây một lần.
QR_SESSION_TIMEOUT_MS=300000

# Chờ người dùng nhập mật khẩu hai lớp. Hết hạn mà không huỷ thì lời gọi đăng nhập
# treo vĩnh viễn và giữ luôn một kết nối MTProto — rò rỉ chậm, rất khó nhìn ra.
PASSWORD_TIMEOUT_MS=180000

# Trần một lần đồng bộ.
SYNC_DIALOG_LIMIT=200
SYNC_MESSAGE_LIMIT=50

CONNECTION_RETRIES=5
