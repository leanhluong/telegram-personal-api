{
  "name": "telegram-personal-api",
  "version": "1.0.0",
  "description": "Backend API service cho Telegram cá nhân qua MTProto — đăng nhập QR như Telegram Desktop, gửi/nhận tin, tệp, cảm xúc, nạp lịch sử.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run build && node --env-file=.env --watch dist/index.js",
    "test": "npm run build && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.9.3"
  }
}
